# Database configuration:
# Prefer db_connection.txt with a line like:
#   psql postgresql://user:pass@host:port/dbname
#
# Fallback environment variables if db_connection.txt is not present:
# POSTGRES_URL=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=
# POSTGRES_DB=

# JWT configuration (set securely in production)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
