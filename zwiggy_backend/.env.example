# Backend configuration example (do NOT commit real secrets)

# JWT configuration (set securely in production)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# Database connection
# Preferred: db_connection.txt file containing a line like:
#   psql postgresql://user:pass@host:port/db
#
# Optional: explicitly point the backend at the db_connection.txt file:
DB_CONNECTION_FILE=/path/to/db_connection.txt

# Fallback options (only used if db_connection.txt is not found)
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
